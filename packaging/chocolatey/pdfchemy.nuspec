<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>pdfchemy</id>
    <version>1.0.0</version>
    <title>PDFchemy Tools</title>
    <authors>Andrei Ioan Cucos</authors>
    <owners>Andrei Ioan Cucos</owners>
    <projectUrl>https://github.com/cucosandrei/pdfchemy</projectUrl>
    <bugTrackerUrl>https://github.com/cucosandrei/pdfchemy/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/cucosandrei/pdfchemy/blob/main/README.md</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>pdf compress editor page-studio merge split privacy offline utility</tags>
    <summary>100% Offline Emergency Document Utility for the people</summary>
    <description>
PDFchemy Tools is a fast, 100% offline, privacy-focused document utility built for the people.
Zero cloud servers, zero telemetry.

Features:
- Visual Page Studio (reorder, rotate, delete, duplicate pages visually)
- Smart Target Compressor (auto-tunes to fit under 2MB for email/portal uploads)
- Images ⇄ PDF Studio (compile photos into PDFs, extract pages to PNG)
- Multi-Core Batch Queue (compress or merge 50+ PDFs simultaneously across all cores)
- Document Security (128/256-bit AES encryption & password removal)
    </description>
    <releaseNotes>https://github.com/cucosandrei/pdfchemy/releases/tag/v1.0.0</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
